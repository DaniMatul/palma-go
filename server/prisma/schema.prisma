generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OrderItemType {
  MENU
  EXTRA
  CUSTOM
}

enum DailyMenuStatus {
  ACTIVE
  CLOSED
}

enum MenuCategory {
  BREAKFAST
  SNACK
  LUNCH
  DINNER
}

model MenuItem {
  id             String          @id @default(cuid())
  name           String
  description    String
  price          Decimal
  category       MenuCategory?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  dailyMenuItems DailyMenuItem[]
  orderItems     OrderItem[]
}

model DailyMenu {
  id        String          @id @default(cuid())
  date      DateTime
  status    DailyMenuStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     DailyMenuItem[]
  orders    Order[]
}

model DailyMenuItem {
  id                String      @id @default(cuid())
  dailyMenuId       String
  menuItemId        String
  price             Decimal     @default(0)
  active            Boolean     @default(true)
  availableQuantity Int         @default(0)
  remainingQuantity Int         @default(0)
  soldQuantity      Int         @default(0)
  revenue           Decimal     @default(0)
  dailyMenu         DailyMenu   @relation(fields: [dailyMenuId], references: [id], onDelete: Cascade)
  menuItem          MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  orderItems        OrderItem[]

  @@unique([dailyMenuId, menuItemId])
}

model Extra {
  id         String      @id @default(cuid())
  name       String
  price      Decimal
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]
}

model Order {
  id           String      @id @default(cuid())
  dailyNumber  Int
  orderDate    DateTime
  customerName String
  address      String
  createdAt    DateTime    @default(now())
  promiseTime  DateTime
  status       OrderStatus @default(IN_PROGRESS)
  total        Decimal
  dailyMenuId  String?
  items        OrderItem[]
  accounts     OrderAccount[]
  dailyMenu    DailyMenu?  @relation(fields: [dailyMenuId], references: [id], onDelete: SetNull)

  @@unique([orderDate, dailyNumber])
}

model OrderAccount {
  id        String      @id @default(cuid())
  orderId   String
  name      String?
  position  Int         @default(1)
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items     OrderItem[]

  @@index([orderId, position])
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  type            OrderItemType
  description     String
  quantity        Int
  unitPrice       Decimal
  subtotal        Decimal
  menuItemId      String?
  extraId         String?
  dailyMenuItemId String?
  orderAccountId  String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderAccount    OrderAccount   @relation(fields: [orderAccountId], references: [id], onDelete: Cascade)
  menuItem        MenuItem?      @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  extra           Extra?         @relation(fields: [extraId], references: [id], onDelete: Restrict)
  dailyMenuItem   DailyMenuItem? @relation(fields: [dailyMenuItemId], references: [id], onDelete: Restrict)
}
